# Настройки сайта «Смена контента» для хостинга Sprinthost (Apache)
# Файл читается автоматически. Трогать его не нужно.

# Главная страница сайта — /, а не стандартная заглушка хостинга
DirectoryIndex index.html index.php index.htm

# Запрет показывать список файлов в папках
Options -Indexes

# Адреса разделов без косой черты на конце: /about, а не /about/
# Служебные папки (assets, api) открываются как обычно — файлы в них, не папки.
DirectorySlash Off

# Кодировка по умолчанию
AddDefaultCharset UTF-8

# Разделы открываются по короткому адресу: /about, /news, /docs.
# Файлы лежат в папках, но адресная строка остаётся чистой.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # старые адреса вида /about.html навсегда переезжают на /about
  RewriteCond %{REQUEST_URI} !/index\.html$
  RewriteRule ^(.+)\.html$ /$1 [R=301,L]

  # /index.html → главная
  RewriteRule ^index\.html$ / [R=301,L]

  # главная — через роутер, мимо кэша
  RewriteRule ^$ /router.php?p=home [L]

  # короткие адреса разделов
  RewriteRule ^news/?$ /router.php?p=news [L]
  RewriteRule ^about/?$ /router.php?p=about [L]
  RewriteRule ^partners/?$ /router.php?p=partners [L]
  RewriteRule ^region/?$ /router.php?p=region [L]
  RewriteRule ^media-school/?$ /router.php?p=media-school [L]
  RewriteRule ^school/?$ /router.php?p=school [L]
  RewriteRule ^docs/?$ /router.php?p=docs [L]
  RewriteRule ^poisk/?$ /router.php?p=poisk [L]
  RewriteRule ^join/?$ /router.php?p=join [L]
  RewriteRule ^profile/?$ /router.php?p=profile [L]
  RewriteRule ^write/?$ /router.php?p=write [L]
  RewriteRule ^admin/?$ /router.php?p=admin [L]
  RewriteRule ^article/?$ /router.php?p=article [L]
  RewriteRule ^support/?$ /router.php?p=support [L]
  RewriteRule ^founders/?$ /router.php?p=founders [L]
  RewriteRule ^verify/?$ /router.php?p=verify [L]

</IfModule>

# Красивая страница для несуществующих адресов
ErrorDocument 404 /404.html

# Правильные типы файлов
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType image/svg+xml .svg
  AddType application/json .json
  AddType application/geo+json .geojson
</IfModule>

# Сжатие текстовых файлов — сайт грузится быстрее
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml application/geo+json
</IfModule>

# Кэш: картинки и шрифты надолго, стили и скрипты — без кэша, чтобы правки
# появлялись быстро. Документы и страницы — никогда не хранить: иначе браузер
# показывает старые PDF и старый интерфейс даже после выкладки.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/pdf "access plus 0 seconds"
</IfModule>

# Безопасность
<IfModule mod_headers.c>
  # код сайта не кэшируем: после обновления браузер сразу видит новую версию
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # страницы и PDF — тем более: старый бланк в кэше хуже, чем лишний запрос
  <FilesMatch "\.(html|pdf)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # Показывать сайт только по HTTPS, после того как включён сертификат
  # Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains"
</IfModule>

# Переадресация на HTTPS и с www на основной домен.
# Включается в панели хостинга (раздел «SSL»), поэтому здесь закомментировано.
# Если понадобится включить здесь — раскомментируйте блок ниже,
# но только после того, как сертификат Let's Encrypt выпущен и работает.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
#   RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
#   RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
# </IfModule>
